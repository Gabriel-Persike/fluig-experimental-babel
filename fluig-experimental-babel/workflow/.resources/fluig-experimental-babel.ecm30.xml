  var user = hAPI.getCardValue(&quot;userId&quot;);
  var comentario = hAPI.getCardValue(&quot;comentarioAprovador&quot;);
  if (!user || !comentario) {
    throw &quot;Usuário ou Comentario não informados&quot;;
  }
  return &quot;&quot;.concat(user, &quot;: &quot;).concat(comentario);
};
